# Wachtwoord voor de lokale Postgres-container (docker-compose)
POSTGRES_PASSWORD=

# Geheime sleutel om dashboard-login-sessies (JWT) mee te ondertekenen.
# Genereer bv. met: openssl rand -hex 32
JWT_SECRET=

# true = gebruik de nagebootste KNLTB-API (voor lokaal testen, geen echte
# boekingen); false = echte API aanroepen (productie)
MOCK_KNLTB=false

# Deze KNLTB_*/PARTNER_MEMBER_IDS/TARGET_*/COURT_PREFERENCE/DURATION_MINUTES/
# BOOKING_WINDOW_DAYS-waarden worden bij de EERSTE opstart eenmalig in de
# database geseed (zie backend SettingsService.seedFromEnvIfEmpty). Daarna is
# het dashboard de bron van waarheid en worden deze env-vars genegeerd.

# De club-ID zoals gebruikt door de KNLTB ClubApp (een UUID, gevonden via het
# reverse-engineerde netwerkverkeer van de app — niet zichtbaar op de website)
KNLTB_CLUB_ID=b818722a-9832-4e00-9829-5d2db2a473b6

# Inloggegevens van je moeder (hetzelfde account als de KNLTB ClubApp)
KNLTB_MEMBERSHIP_NUMBER=
KNLTB_PASSWORD=

# club_member_id's van medespelers die standaard mee moeten in de reservering
# (deze club vereist minimaal 2 spelers per boeking). Komma-gescheiden.
# Vind deze id's door eenmalig `npm run book:now` te draaien met een baan die nog
# leeg is, of via de "buddies"-lijst van het account.
PARTNER_MEMBER_IDS=

# Op welke dag en tijd moet er gereserveerd worden? (24-uurs, Europe/Amsterdam)
TARGET_WEEKDAY=MONDAY
TARGET_TIME=19:00

# Hoeveel dagen van tevoren komt een baan vrij (KNLTB: precies 7 dagen)
BOOKING_WINDOW_DAYS=7

# Baanvoorkeur, komma-gescheiden, van hoog naar laag (leeg = eerste beschikbare baan)
COURT_PREFERENCE=Baan 1,Baan 2,Baan 3

# Speelduur in minuten zoals gebruikt in het reserveringssysteem
DURATION_MINUTES=60
