datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AttemptStatus {
  SUCCESS
  VALIDATION_FAILED
  NO_SLOT_FOUND
  BOOKING_FAILED
  ERROR
  SKIPPED
}

enum TriggerType {
  SCHEDULED
  MANUAL
}

/// Dashboard-gebruiker (inloggen op het dashboard zelf). Los van Account,
/// dat de KNLTB-inloggegevens bevat.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  account      Account?
}

/// De KNLTB-inloggegevens van precies één User (1-op-1). Meerdere
/// wekelijkse reserveringen kunnen hetzelfde account delen, vandaar apart
/// van BookingSchedule.
model Account {
  id               Int               @id @default(autoincrement())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId           String
  /// Weergavenaam van de vereniging bij clubId (denormalized, opgezocht via
  /// de verenigingszoekfunctie tijdens onboarding — zelfde patroon als
  /// BookingSchedule.partnerMemberNames).
  clubName         String?
  membershipNumber String
  password         String
  /// Volledige naam van de gebruiker, ingevuld tijdens onboarding.
  fullName         String?
  /// Gezet zodra de onboarding is voltooid (incl. succesvolle KNLTB-verificatie).
  /// Null = onboarding nog niet doorlopen, ongeacht wat er in de overige
  /// velden staat.
  onboardedAt      DateTime?
  updatedAt        DateTime          @updatedAt
  schedules        BookingSchedule[]
}

/// Eén wekelijkse terugkerende reservering, gekoppeld aan precies één
/// Account. Meerdere rijen per account mogelijk (bv. vrijdagochtend met
/// Henk, zondagavond met Conny).
model BookingSchedule {
  id                 String              @id @default(uuid())
  accountId          Int
  account            Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  label              String?
  partnerMemberIds   String[]            @default([])
  /// Weergavenamen, zelfde volgorde/index als partnerMemberIds (denormalized
  /// voor het dashboard, zodat je geen live KNLTB-lookup nodig hebt om
  /// bestaande medespelers te tonen).
  partnerMemberNames String[]            @default([])
  targetWeekday      Weekday             @default(MONDAY)
  targetTime         String              @default("19:00")
  courtPreference    String[]            @default([])
  durationMinutes    Int                 @default(60)
  enabled            Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  attempts           BookingAttempt[]
  exceptions         ScheduleException[]

  @@index([accountId])
}

/// Eenmalige uitzondering op een BookingSchedule voor precies één
/// kalenderdatum: óf de reservering overslaan (skip), óf een ander
/// medespelers-groepje gebruiken voor die datum — nooit beide (skip=true
/// impliceert lege partner-arrays, afgedwongen in ScheduleExceptionsService).
/// `date` wordt overal als kale YYYY-MM-DD-string behandeld (UTC-middernacht
/// encoding) om DST-gerelateerde off-by-one-bugs te voorkomen — zie
/// BookingRunnerService en ScheduleExceptionsService.
model ScheduleException {
  id                 String          @id @default(uuid())
  scheduleId         String
  schedule           BookingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  date               DateTime        @db.Date
  skip               Boolean         @default(true)
  partnerMemberIds   String[]        @default([])
  partnerMemberNames String[]        @default([])
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([scheduleId, date])
  @@index([scheduleId])
}

/// Singleton rij (id altijd 1) met site-brede statistieken voor de
/// homepage. In tegenstelling tot Account is dit bewust wél een singleton:
/// het is geen per-gebruiker data, maar een cijfer over alle gebruikers
/// heen.
model GlobalStats {
  id                    Int @id @default(1)
  /// Opgehoogd bij elke BookingSchedule.create(), nooit verlaagd — ook niet
  /// als een reservering later verwijderd wordt. Zie SchedulesService.create().
  totalSchedulesCreated Int @default(0)
}

model BookingAttempt {
  id                 String          @id @default(uuid())
  scheduleId         String
  schedule           BookingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  createdAt          DateTime        @default(now())
  trigger            TriggerType     @default(SCHEDULED)
  dryRun             Boolean         @default(false)
  targetStart        DateTime
  targetEnd          DateTime
  status             AttemptStatus
  courtId            String?
  courtName          String?
  /// True als dit een andere baan is dan de ingestelde courtPreference
  /// (eenmalige fallback naar hetzelfde baantype omdat de voorkeursbaan
  /// geen slot had, bv. bezet voor training). Zie knltb-matching.ts.
  courtFallback      Boolean         @default(false)
  validationResponse Json?
  reservationId      String?
  errorMessage       String?
  rawResult          Json?
  durationMs         Int?

  @@index([scheduleId, createdAt])
}
